# =============================================================================
# Angren super-app — production environment for the Oracle VM.
#
#   cp deploy/oracle/.env.prod.example deploy/oracle/.env.prod
#   deploy/oracle/gen-secrets.sh            # fills every CHANGE_ME secret
#   chmod 600 deploy/oracle/.env.prod
#
# This file is read twice:
#   1. by `docker compose --env-file` for ${VAR} interpolation in
#      docker-compose.prod.yml (DOMAIN, DB_*, REDIS_PASSWORD, ...);
#   2. by the backend container as its env_file (integration keys below).
# A variable you do not use: leave it COMMENTED OUT rather than empty — some
# backend settings are validated and an empty value fails the boot.
#
# Never commit .env.prod (deploy/oracle/.gitignore ignores it).
# =============================================================================

# ---- Domain / TLS -----------------------------------------------------------
# Root domain. Caddy serves api.<DOMAIN>, admin.<DOMAIN>, manager.<DOMAIN>,
# market.<DOMAIN>, restaurant.<DOMAIN> — create an A record for each.
DOMAIN=angren.example.uz
# Let's Encrypt account e-mail (expiry warnings go here).
ACME_EMAIL=admin@example.uz
# Extra CORS origins, each prefixed with a comma, e.g. ",https://angren.uz".
# CORS_EXTRA_ORIGINS=

# ---- PostgreSQL (PostGIS) ---------------------------------------------------
DB_USER=angren
DB_NAME=angren_taxi
DB_PASS=CHANGE_ME

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# ---- Auth -------------------------------------------------------------------
# JWT signing key, >= 32 chars. Rotating it logs every user out.
APP_SECRET=CHANGE_ME
# Token lifetimes (seconds or 15m / 12h / 7d). Backend defaults: 7d / 30d.
# JWT_ACCESS_TTL=7d
# JWT_REFRESH_TTL=30d

# ---- OTP / SMS (Eskiz.uz) ---------------------------------------------------
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Test-only fixed OTP. In production BOTH flags must be "true" to take effect,
# and the backend logs a loud warning. Keep commented out for real launch.
# OTP_BYPASS_ENABLED=true
# ALLOW_OTP_BYPASS_IN_PROD=true
# OTP_BYPASS_CODE=123456
#
# Closed pilot without SMS: ONLY the listed numbers log in with OTP_BYPASS_CODE
# (which must then be set explicitly — never left at the 123456 default);
# every other number still needs a real SMS. Does not need the two flags above.
# Remove both lines once Eskiz is live.
# OTP_BYPASS_PHONES=+998901234567,+998901234568
# OTP_BYPASS_CODE=<6 random digits, shared only with testers>

# ---- Payments ---------------------------------------------------------------
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# UZCARD_API_KEY=
# UZCARD_SECRET_KEY=
# UZCARD_TERMINAL_ID=

# ---- Fiscal receipts (OFD) --------------------------------------------------
# "noop" = receipts recorded, nothing sent to the tax office.
FISCAL_PROVIDER=noop

# ---- Push notifications (Firebase Cloud Messaging) ---------------------------
# From the Firebase service-account JSON. Keep the private key on ONE line,
# double-quoted, with literal \n sequences.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- File storage (driver KYC documents) ------------------------------------
# s3 = private Cloudflare R2 bucket (recommended). local = Docker volume
# `backend_uploads` on this VM (then it is only as safe as backups).
STORAGE_DRIVER=s3
S3_BUCKET=angren-kyc
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
# (EU-jurisdiction bucket: https://<account-id>.eu.r2.cloudflarestorage.com)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME_R2
S3_SECRET_ACCESS_KEY=CHANGE_ME_R2
# S3_FORCE_PATH_STYLE=true

# ---- Error tracking / pricing flags -----------------------------------------
# Sentry (Node.js loyihasi DSN'i). Bo'sh — o'chiq. Shaxsiy ma'lumot yuborilmaydi
# (common/observability/error-reporting.ts). Tracing: SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_DSN=
# ROUTED_DISTANCE_PRICING=false

# ---- Web panels -------------------------------------------------------------
# Public URLs are derived from DOMAIN in docker-compose.prod.yml
# (NEXT_PUBLIC_API_URL=https://api.<DOMAIN>/api/v1, NEXT_PUBLIC_SOCKET_URL=
# https://api.<DOMAIN>; runtime API_URL/SOCKET_URL = internal http://backend:3000).
# Only the manager map key is configurable — baked in at build time.
NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_MAPTILER_STYLE=

# ---- Backups (deploy/oracle/backup.sh) --------------------------------------
# Local copies: /var/backups/angren (7 daily + 4 weekly).
BACKUP_DIR=/var/backups/angren
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Off-box copy to Cloudflare R2 via rclone (S3 API). Use a SEPARATE bucket and a
# SEPARATE API token scoped to it (Object Read & Write) — not the KYC token.
# Leave BACKUP_S3_BUCKET empty to keep backups on the VM only (not recommended).
BACKUP_S3_BUCKET=angren-db-backups
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_R2
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME_R2
# Symmetric GPG passphrase for the off-box copy (dumps hold personal data).
# STORE IT OUTSIDE THE VM TOO (password manager) — without it the R2 copies
# cannot be restored.
BACKUP_GPG_PASSPHRASE=CHANGE_ME

# ---- Monitoring (deploy/oracle/healthcheck-alert.sh) ------------------------
# Optional Telegram alerts: create a bot with @BotFather, send it a message,
# read chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Consecutive failed checks (1/min) before alerting.
ALERT_AFTER_FAILURES=3

# ---- Biznes hisobotlari (backend modules/business-reports) ------------------
# Same Telegram bot: daily finance report 08:00, weekly Monday 08:05 (Tashkent).
# X-Reports-Key for the owner's Claude department skills; gen-secrets.sh fills it.
REPORTS_API_KEY=CHANGE_ME

# Ilova versiyasi (GET /app/version). MIN dan past build "yangilang" ekranida
# to'xtaydi (xato APK'ni to'xtatish); LATEST dan pastiga yumshoq taklif.
# Build raqami = mobile/tool/build_release.sh chiqargan versionCode.
# Bo'sh/0 — hech kim bloklanmaydi.
APP_MIN_BUILD_PASSENGER=0
APP_LATEST_BUILD_PASSENGER=0
APP_UPDATE_URL_PASSENGER=
APP_MIN_BUILD_DRIVER=0
APP_LATEST_BUILD_DRIVER=0
APP_UPDATE_URL_DRIVER=
