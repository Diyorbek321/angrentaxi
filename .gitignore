# ===== Secrets / env =====
.env
.env.*
!.env.example
*.pem
*.key
nginx/ssl/*
!nginx/ssl/.gitkeep

# ===== Node / NestJS / Next.js =====
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Flutter / Dart =====
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
**/.dart_tool/
**/*.g.dart.lock

# ===== DB backups =====
# Everything in here is a production dump: real phone numbers, ride history and
# wallet balances. Ignore the directory wholesale rather than by extension —
# a .json logical dump used to slip straight past the .sql/.dump patterns.
backups/*
!backups/.gitkeep

# ===== Uploaded driver KYC documents (local disk storage, dev/MVP only) =====
backend/uploads/driver-documents/*
!backend/uploads/driver-documents/.gitkeep

# ===== OS / Editor =====
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.log

# ===== Internal / sales docs =====
# Sales scripts and interior-design AI prompts kept in the repo root by the
# owner. They are not part of the platform — ignored rather than deleted.
Sotuv skript*.docx
Sotuv skript - qismlar/
Xona*.docx
Xona_*.txt
prompt.txt/
*.odt

# ===== Build artifacts (distribute via GitHub Releases, not git) =====
apk/*.apk

# ===== Android release signing =====
# The keystore and its passwords must never enter the repo. Losing them means
# no future update can be published to the same Play Store listing, so keep an
# offline backup. See mobile/android/key.properties.example.
mobile/android/key.properties
*.jks
*.keystore

# JVM heap dumplari — Gradle OOM'da avtomatik hosil bo'ladi (GB'larda).
# Ular hech qachon commit qilinmasligi kerak: tarixdan olib tashlash uchun
# butun tarixni qayta yozish talab qilinadi.
*.hprof

# Qurilgan APK/AAB artefaktlari — relizlar git'da emas, chiqarish
# quvurida saqlanadi.
apk/
*.apk
*.aab
