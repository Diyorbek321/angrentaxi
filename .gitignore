# ===== Flutter / Dart =====
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
**/.dart_tool/
**/*.g.dart.lock

# ===== DB backups =====
backups/*.sql
backups/*.dump
