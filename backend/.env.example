NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml credentials)
DB_HOST=localhost
DB_PORT=5432
DB_USER=angren
DB_PASS=angren_pass
DB_NAME=angren_taxi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# APP_SECRET must be at least 32 characters (startup fails otherwise).
APP_SECRET=your-super-secret-key-change-in-production
# Token lifetimes (seconds, or 15m / 12h / 7d). Optional — defaults shown.
# Defaults are deliberately long: the mobile app has no token-refresh flow yet
# (a 401 logs the user out) and the web panels do not store refresh tokens.
# Once updated clients are rolled out, shorten JWT_ACCESS_TTL to e.g. 15m.
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# Eskiz SMS
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password

# Payme
PAYME_MERCHANT_ID=your-merchant-id
PAYME_SECRET_KEY=your-secret-key

# Click
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key

# Uzcard / UZPS
UZCARD_TERMINAL_ID=your-uzcard-terminal-id
UZCARD_API_KEY=your-uzcard-api-key
UZCARD_SECRET_KEY=your-uzcard-secret-key

# Firebase (optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="your-private-key"

# OTP Dev bypass
OTP_BYPASS_ENABLED=false

# TypeORM schema synchronize (see src/config/db-synchronize.util.ts)
# - development (NODE_ENV != production): defaults ON; set DB_SYNC=false to disable.
# - production (NODE_ENV=production): defaults OFF for safety — auto-syncing can
#   silently alter/drop columns on the live DB on every deploy. Production requires
#   an explicit DB_SYNC=true opt-in to enable it.
# DB_SYNC=false
