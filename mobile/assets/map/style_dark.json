          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          12,
          2.2,
          16,
          9.5,
          20,
          36
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
