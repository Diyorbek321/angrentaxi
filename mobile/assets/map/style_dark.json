      "paint": {
        "line-color": "#4A4A36",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          10,
          2.5,
          14,
          8.5,
          18,
          28,
          20,
          47
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "<=",
        "admin_level",
        4
      ],
      "paint": {
        "line-color": "#2E403A",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          10,
          1.4
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:uz"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          10,
          14,
          11,
          18,
          14
        ],
        "text-letter-spacing": 0.02,
        "text-max-angle": 30,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#96AAA2",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1.4
      },
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
