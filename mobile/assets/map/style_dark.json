{
  "version": 8,
  "name": "Angren Mint — Dark",
  "metadata": {
    "angren:note": "style_light.json ning tungi juftligi — QATLAMLAR RO'YXATI BIR XIL, faqat ranglar boshqa. Bittasiga qatlam qo'shsangiz, ikkinchisiga ham qo'shing.",
    "angren:principle": "Tunda ko'z qorong'ilikka moslashgan. Yer deyarli qora, yo'llar och-kulrang. Mint marshrut chizig'i shu fonda eng yorqin element bo'ladi."
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={MAPTILER_KEY}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://api.maptiler.com/tiles/v3/{z}/{x}/{y}?key={MAPTILER_KEY}"
      ],
      "minzoom": 0,
      "maxzoom": 15,
      "attribution": "<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">&copy; MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B1210"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "residential",
        "suburb",
        "neighbourhood"
      ],
      "paint": {
        "fill-color": "#101815"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#0E1A15",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "grass",
        "farmland"
      ],
      "paint": {
        "fill-color": "#0F1B16"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#101F19"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        "brunnel",
        "tunnel"
      ],
      "paint": {
        "fill-color": "#13252A"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#13252A",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          14,
          2,
          18,
          5
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#16211D",
        "fill-outline-color": "#1D2A25",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14.5,
          1
        ]
      }
    },
    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "rail",
        "transit"
      ],
      "paint": {
        "line-color": "#1D2A25",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          16,
          2.5
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "path",
        "track"
      ],
      "minzoom": 14,
      "paint": {
        "line-color": "#25352F",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.8,
          18,
          2.5
        ],
        "line-dasharray": [
          2,
          2
        ]
      }
    },
