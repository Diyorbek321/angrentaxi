{
  "version": 8,
  "name": "Angren Mint — Dark",
  "metadata": {
    "angren:note": "style_light.json ning tungi juftligi — QATLAMLAR RO'YXATI BIR XIL, faqat ranglar boshqa. Bittasiga qatlam qo'shsangiz, ikkinchisiga ham qo'shing.",
    "angren:principle": "Tunda ko'z qorong'ilikka moslashgan. Yer deyarli qora, yo'llar och-kulrang. Mint marshrut chizig'i shu fonda eng yorqin element bo'ladi."
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key={MAPTILER_KEY}",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key={MAPTILER_KEY}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0B1210" }
    },

    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": { "fill-color": "#101815" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#0E1A15", "fill-opacity": 0.9 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "farmland"],
      "paint": { "fill-color": "#0F1B16" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#101F19" }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", "brunnel", "tunnel"],
      "paint": { "fill-color": "#13252A" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#13252A",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          9, 0.6,
          14, 2,
          18, 5
        ]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#16211D",
        "fill-outline-color": "#1D2A25",
        "fill-opacity": [
          "interpolate", ["linear"], ["zoom"],
          13, 0,
          14.5, 1
        ]
      }
    },

    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "rail", "transit"],
      "paint": {
        "line-color": "#1D2A25",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.7,
          16, 2.5
        ]
      }
    },

    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"],
      "minzoom": 14,
      "paint": {
        "line-color": "#25352F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.8, 18, 2.5],
        "line-dasharray": [2, 2]
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 12,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#16211D",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 1.5,
          14, 3,
          18, 16,
          20, 34
        ]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#18241F",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 1.2,
          12, 3.5,
          16, 12,
          20, 40
        ]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1B2822",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          5, 1.2,
          10, 4,
          14, 11,
          18, 32,
          20, 52
        ]
      }
    },

    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 12,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#212E29",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.5,
          14, 1.8,
          18, 13,
          20, 30
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#2A3A33",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, 0.5,
          12, 2.2,
          16, 9.5,
          20, 36
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#36483F",
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          5, 0.5,
          10, 2.5,
          14, 8.5,
          18, 28,
          20, 47
        ]
      }
    },

    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 4],
      "paint": {
        "line-color": "#2E403A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 10, 1.4],
        "line-dasharray": [3, 2]
      }
    },

    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:uz"], ["get", "name"], ["get", "name:latin"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 13],
        "text-letter-spacing": 0.02,
        "text-max-angle": 30,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#96AAA2",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:uz"], ["get", "name"], ["get", "name:latin"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-letter-spacing": 0.06
      },
      "paint": {
        "text-color": "#6E8E93",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-place-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "quarter", "village", "hamlet"],
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name:uz"], ["get", "name"], ["get", "name:latin"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 11, 16, 13],
        "text-letter-spacing": 0.04,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#96AAA2",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "label-place-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:uz"], ["get", "name"], ["get", "name:latin"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 17, 16, 20],
        "text-letter-spacing": 0.01,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#E8F1ED",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1.8
      }
    }
  ]
}
