      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service"
      ],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#16211D",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          12,
          1.5,
          14,
          3,
          18,
          16,
          20,
          34
