      "paint": {
        "text-color": "#6F837B",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-poi",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 16,
      "filter": [
        "all",
        [
          "in",
          "class",
          "hospital",
          "clinic",
          "pharmacy",
          "place_of_worship",
          "school",
          "college",
          "university",
          "marketplace",
          "shop",
          "grocery",
          "fuel",
          "bank",
          "bus",
          "railway",
          "town_hall",
          "stadium"
        ],
        [
          "has",
          "name"
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:uz"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          16,
          10,
          18,
          12
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-padding": 6
      },
      "paint": {
        "text-color": "#8BA098",
        "text-halo-color": "#0B1210",
        "text-halo-width": 1.4
