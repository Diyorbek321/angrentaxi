<?xml version="1.0" encoding="utf-8"?>
<!--
  FAQAT DEBUG build'lar uchun tarmoq siyosati.

  Bu fayl `src/main` dagi bir xil nomli faylni DEBUG variantida almashtiradi
  (Android resurs overlay qoidasi). Release build'da o'sha qat'iy asl
  konfiguratsiya o'z kuchida qoladi — bu yerda hech narsa yumshatilmaydi.

  ⚠️ NEGA KERAK. Asosiy konfiguratsiyada cleartext faqat `localhost`,
  `10.0.2.2` va `192.168.0.0` uchun ochiq. Uchinchisi mo'ljallanganidek
  ishlamaydi: `<domain>` xost NOMINI kutadi, CIDR diapazonini emas — ya'ni
  faqat aynan `192.168.0.0` degan xost mos keladi. Natijada haqiqiy telefonda
  ishlab chiqish serveriga (masalan `10.68.131.35:3100`) ulanish "cleartext
  not permitted" bilan yiqilardi va sabab ilova ichida hech qanday tarmoq
  xatosidan farq qilmasdi.

  Har bir ishlab chiquvchining IP'sini asosiy faylga qo'shish o'rniga —
  bu mashinaga bog'liq va commit'ga tushib qolardi — debug variantida
  cleartext umuman ochiladi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
