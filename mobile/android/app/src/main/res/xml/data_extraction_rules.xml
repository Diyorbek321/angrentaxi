<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutga ham, qurilmadan qurilmaga ham hech narsa ko'chmaydi
     (AndroidManifest.xml dagi allowBackup izohiga qarang). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
