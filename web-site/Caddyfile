# Sayt konteyneri ichidagi statik server. TLS va domen — tashqi Caddy'da
# (deploy/oracle/Caddyfile), bu yerga faqat ichki tarmoqdan HTTP keladi.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Nomida xesh bor — abadiy keshlanadi; HTML har safar tekshiriladi.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /static/*
	header @static Cache-Control "public, max-age=604800"
	@html path / /ru/ *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# /ru → /ru/ (nisbiy havolalar to'g'ri ishlashi uchun).
	redir /ru /ru/ 308

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}
