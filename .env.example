# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=angren
DB_PASS=angren_pass
DB_NAME=angren_taxi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
APP_SECRET=change-me-in-production

# SMS (Eskiz.uz)
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your_password
ESKIZ_FROM=4546

# Firebase (FCM push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Maps (MapTiler Cloud) — xarita plitkalari.
# Klient tomonda ishlatiladi (web-manager bundle + mobil ilova), shuning uchun
# maxfiy emas; himoya MapTiler panelidagi domen/origin cheklovi orqali.
MAPTILER_API_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Routing (OSRM). Bo'sh qoldirilsa, backend OSRM'ning ommaviy demo serveriga
# tushadi — u rate-limit ostida va SLA'siz. Prod uchun majburiy.
# Lokal: docker compose up -d osrm (graf build paytida quriladi).
# Railway: cd osrm && railway up . --path-as-root --service osrm, so'ng
#   OSRM_URL=http://osrm.railway.internal:5000 (PORT=5000 ni osrm servisiga bering)
# Mobil ilova OSRM'ga to'g'ridan-to'g'ri bormaydi — backend'dagi
# GET /routing/route orqali oladi.
OSRM_URL=http://osrm:5000

# Fayl saqlash (haydovchi KYC hujjatlari, tekshiruv fotolari).
#   local — konteyner diski (uploads/). Railway'da volume'siz har deploy'da O'CHADI.
#   s3    — istalgan S3-mos bucket: Cloudflare R2, Railway Bucket, MinIO, AWS S3.
# Bucket PRIVATE bo'lishi shart: fayllar faqat backend ruxsat tekshirgandan
# keyin oqim bilan beriladi, ochiq URL hech qachon yaratilmaydi.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com · AWS uchun bo'sh qoldiring
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO uchun true
S3_FORCE_PATH_STYLE=false

# Safar tugagach narxni to'g'ri chiziq emas, HAQIQIY yo'l masofasi bo'yicha
# hisoblash (OSRM orqali). O'chirilgan holda qoldirilgan: yoqilsa har bir
# safar narxi oshadi (yo'l masofasi to'g'ri chiziqdan uzunroq) — bu biznes
# qarori. Bir necha real safarni ikkala usulda solishtirib ko'ring
# (completion logida ikkala raqam ham chiqadi), keyin yoqing.
ROUTED_DISTANCE_PRICING=false

# Payments - Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Payments - Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payments - Uzcard/Humo
UZCARD_TERMINAL_ID=
UZCARD_API_KEY=
UZCARD_SECRET_KEY=

# Sentry
SENTRY_DSN=

# OTP bypass (development only)
OTP_BYPASS_CODE=123456
OTP_BYPASS_ENABLED=true
# OTP kodini `/auth/send-otp` JAVOBIDA qaytarish. Faqat mahalliy ishlab
# chiqish uchun: yoqilgan bo'lsa telefon raqamini bilgan har qanday odam
# istalgan hisobga kira oladi. Jonli serverda HECH QACHON 'true' bo'lmasin —
# kod baribir server jurnalida bor.
OTP_ECHO_CODE=false

# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
